# Copiar como .env y ajustar. Todas las variables son opcionales.

# --- Servidor (middleware) ---
SERVER_PORT=5000
# Nombre de rol que envía el cliente de visualización en join_session
ROLE_DISPLAY=display
# Nombre de rol que envía el cliente de IA en join_session
ROLE_AI=ai
# Orígenes permitidos para CORS: "*" o lista separada por comas
CORS_ALLOWED_ORIGINS=*
# Título de la API (página principal y documentación OpenAPI)
API_TITLE=WebSocket Communication System

# --- Cliente web de pruebas ---
WEB_TESTER_PORT=3000
# URL del servidor tal como la ve el navegador
SERVER_PUBLIC_URL=http://localhost:5000

# Compatibilidad con clientes que usan los nombres de rol del proyecto
# de origen: ROLE_DISPLAY=unity y ROLE_AI=ia
